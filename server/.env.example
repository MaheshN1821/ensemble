# --- Server ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CLIENT_ORIGINS=http://localhost:5173

# --- MongoDB Atlas (metadata only: sessions, ledger, catalogs) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ensemble?retryWrites=true&w=majority

# --- YouCam API (server-side only, never expose to the client) ---
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Documented limits are 5 req/s and 250 req/5 min per key and IP. We stay under them.
YOUCAM_RATE_PER_SECOND=4
YOUCAM_RATE_PER_WINDOW=230
YOUCAM_WINDOW_SECONDS=300
YOUCAM_CONCURRENCY=3
YOUCAM_POLL_INTERVAL_MS=5000
YOUCAM_TASK_TIMEOUT_MS=120000
# Optional JSON map to pin unit prices if the feature-cost response can't be matched, e.g. {"skin-tone-analysis":1}
YOUCAM_UNIT_OVERRIDES=
# Used for budget checks only when a feature's price can't be resolved
UNKNOWN_FEATURE_UNITS=5

# --- Spending caps (1,000 free units per participant) ---
SESSION_TTL_HOURS=24
SESSION_UNIT_CAP=120
GLOBAL_DAILY_UNIT_CAP=900

# --- Render pipeline (Stage 6) ---
# YouCam feature paths (the part after /s2s/v2.0/task/). Change only if the docs say otherwise.
YOUCAM_FEATURE_CLOTHES=cloth-v4
YOUCAM_FEATURE_EARRINGS=2d-vto/earring
YOUCAM_FEATURE_NECKLACE=2d-vto/necklace
YOUCAM_FEATURE_MAKEUP=makeup-vto
# Jewellery payload shape: files | info | both. The server tries the others on a 400 and remembers what worked.
YOUCAM_2D_VTO_STYLE=files
# Ask YouCam to delete each finished task after its result is copied to our storage (FR-31)
RENDER_DELETE_TASKS=true
# Most stage runs (not cache hits) one session may send to YouCam
SESSION_RENDER_CAP=30
# Signs the 24-hour share links. Set a long random string; without it links die on every restart.
SHARE_SECRET=

# --- Agent layer (Stage 7) ---
# The language model only reads typed requests into a fixed schema and rephrases facts the planner produced. It never picks
# items, prices or scores. Leave LLM_API_KEY empty to run without one: chips and a keyword reader still work.
# LLM_PROVIDER=anthropic        # anthropic | openai (any OpenAI-compatible endpoint) | none. Defaults to anthropic when a key is set.
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5    # default per provider (openai: gpt-4o-mini)
# LLM_BASE_URL=                 # only for an OpenAI-compatible host, e.g. https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=12000
# Let the model phrase the reply (checked against the planner's facts). false = always use the planner's own wording.
AGENT_LLM_EXPLAIN=true
# Per-session limits: refinements, and language-model calls
AGENT_SESSION_TURN_CAP=40
AGENT_SESSION_LLM_CAP=60

# --- Catalogs (Stage 4) ---
# Public address of the client. Sample catalog images live there; the server needs it to fetch them at render time.
# Leave empty to use the first CLIENT_ORIGINS entry.
PUBLIC_CLIENT_URL=
# Retailer catalogs are removed this many days after their last change
CATALOG_TTL_DAYS=30
# Per-IP limit on catalog imports (each one downloads images)
CATALOG_IMPORTS_PER_HOUR=12

# --- Cloudinary (temporary image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Enables /api/dev/* routes (the System page uses one to run a real task). Keep false in production.
ENABLE_DEV_ROUTES=true
